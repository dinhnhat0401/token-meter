# Required for scripts/notarize.sh and the GitHub Actions release workflow.
# Local: copy to .env and source it. CI: set as repo secrets with the same names.

# Apple ID used to log in to App Store Connect / notarytool.
APPLE_ID=you@example.com

# App-specific password generated at https://appleid.apple.com (NOT your Apple ID password).
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your Apple Developer Team ID (10 chars, e.g. ABCDE12345).
APPLE_TEAM_ID=ABCDE12345

# Common Name of the Developer ID Application certificate, e.g.
# "Developer ID Application: Nhat Dinh (ABCDE12345)".
DEVELOPER_ID_APPLICATION="Developer ID Application: Nhat Dinh (ABCDE12345)"

# CI-only — base64-encoded .p12 of the Developer ID Application cert and its password.
# Generate locally:
#   base64 -i developer_id.p12 | pbcopy
# DEVELOPER_ID_CERT_P12_BASE64=...
# DEVELOPER_ID_CERT_PASSWORD=...
